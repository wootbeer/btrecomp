# Editor settings
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vs/
.DS_Store

# The game: never committed, in any dump format or archive
*.z64
*.n64
*.v64
*.7z

# Everything generated from the ROM
RecompiledFuncs/
RecompiledPatches/
rsp/
*.elf
patches/*.o
patches/*.d
patches/*.bin
patches/*.map
# Disassembly tools' output and exports, which would contain the game's code
*.gpr
*.rep/
ghidra_exports/
/asm/
/.splache/
assets/unk_*.bin

# Recompiler binaries built from the submodule (or a symlink to one)
/N64Recomp
/RSPRecomp

# Build output
build/
build-*/
dist/
out/
*.o
*.exe
*.dll
*.lib
*.pdb
[Dd]ebug/
[Rr]elease/
x64/
x86/

# Files the game writes when run from the repo
imgui.ini
rt64.log
crash_log.txt
pacing_log.txt
gamecontrollerdb.txt
